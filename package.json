{
  "name": "personal-style-bookkeeping",
  "version": "1.0.0",
  "description": "个人风格化记账：本地优先的 Obsidian 记账插件，支持每周账本、大类与小类联动、共享凭证、仪表盘与记账锁。",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "audit": "node scripts/audit-ledger.mjs"
  },
  "keywords": [
    "obsidian",
    "bookkeeping",
    "finance",
    "markdown"
  ],
  "author": "Personal Style Bookkeeping",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "happy-dom": "21.0.4",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "yaml": "2.9.1"
  }
}
